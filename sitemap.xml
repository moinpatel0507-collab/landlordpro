    .features-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;margin-top:48px}
    .feature-card{background:white;border-radius:16px;padding:24px;border:1px solid #EBF0FA;box-shadow:0 2px 12px rgba(27,43,75,.05);transition:transform .2s,box-shadow .2s}
